index 4c0cca7..28da62a 100644
--- a/Services/UserService.cs
+++ b/Services/UserService.cs
@@ -668,5 +668,146 @@ namespace MailArchiver.Services
         }
 
         #endregion
+
+        #region fnOS gateway identity link
+
+        /// <summary>
+        /// Finds the local account linked to an fnOS gateway subject.
+        /// </summary>
+        public async Task<User?> GetUserByGatewaySubjectAsync(string subject)
+        {
+            if (string.IsNullOrWhiteSpace(subject))
+            {
+                return null;
+            }
+
+            return await _context.Users
+                .AsNoTracking()
+                .FirstOrDefaultAsync(u => u.OAuthRemoteUserId == subject);
+        }
+
+        /// <summary>
+        /// Links an fnOS subject to an existing local account (1:1).
+        ///
+        /// Written as a single-column, conditionally-applied UPDATE rather than a full entity
+        /// update, for three reasons: it cannot clobber unrelated fields being edited elsewhere;
+        /// the <c>WHERE OAuthRemoteUserId IS NULL</c> guard makes concurrent linking safe; and the
+        /// unique filtered index on that column turns a double-link race into a database error we
+        /// translate into a readable result instead of a 500.
+        ///
+        /// Note: this only writes the link. IsActive / RequiresApproval / IsAdmin are deliberately
+        /// left untouched — granting privileges is the administrator's decision, not the gateway's.
+        /// </summary>
+        public async Task<GatewayBindResult> TryBindGatewaySubjectAsync(int userId, string subject)
+        {
+            if (string.IsNullOrWhiteSpace(subject))
+            {
+                return GatewayBindResult.InvalidSubject;
+            }
+
+            var user = await _context.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);
+            if (user == null)
+            {
+                return GatewayBindResult.UserNotFound;
+            }
+
+            if (!string.IsNullOrEmpty(user.OAuthRemoteUserId))
+            {
+                return user.OAuthRemoteUserId == subject
+                    ? GatewayBindResult.AlreadyBoundToSame
+                    : GatewayBindResult.AccountAlreadyBound;
+            }
+
+            var subjectHolder = await _context.Users.AsNoTracking()
+                .FirstOrDefaultAsync(u => u.OAuthRemoteUserId == subject);
+            if (subjectHolder != null)
+            {
+                return subjectHolder.Id == userId
+                    ? GatewayBindResult.AlreadyBoundToSame
+                    : GatewayBindResult.SubjectAlreadyBound;
+            }
+
+            try
+            {
+                var affected = await _context.Users
+                    .Where(u => u.Id == userId && (u.OAuthRemoteUserId == null || u.OAuthRemoteUserId == ""))
+                    .ExecuteUpdateAsync(setters => setters.SetProperty(u => u.OAuthRemoteUserId, subject));
+
+                if (affected > 0)
+                {
+                    _logger.LogInformation(
+                        "Linked fnOS subject {Subject} to user {Username} (ID: {UserId}).",
+                        subject, user.Username, user.Id);
+                    return GatewayBindResult.Success;
+                }
+
+                // Lost the race: somebody linked this account between our read and our write.
+                return GatewayBindResult.AccountAlreadyBound;
+            }
+            catch (Exception ex) when (IsUniqueViolation(ex))
+            {
+                _logger.LogWarning(
+                    "Link of fnOS subject {Subject} to user (ID: {UserId}) hit a unique constraint; treating as already linked.",
+                    subject, userId);
+                return GatewayBindResult.AccountAlreadyBound;
+            }
+        }
+
+        /// <summary>
+        /// Removes the fnOS link from an account. Clearing the column is all that is needed:
+        /// every "external account" restriction in the codebase is expressed as
+        /// <c>!string.IsNullOrEmpty(OAuthRemoteUserId)</c>, so password sign-in, password changes
+        /// and 2FA automatically become available again.
+        /// </summary>
+        public async Task<bool> UnbindGatewaySubjectAsync(int userId)
+        {
+            var affected = await _context.Users
+                .Where(u => u.Id == userId && u.OAuthRemoteUserId != null)
+                .ExecuteUpdateAsync(setters => setters.SetProperty(u => u.OAuthRemoteUserId, (string?)null));
+
+            if (affected > 0)
+            {
+                _logger.LogInformation("Removed fnOS link from user ID {UserId}.", userId);
+                return true;
+            }
+
+            return false;
+        }
+
+        /// <summary>
+        /// Stamps the last-login time with a targeted UPDATE (no full-entity rewrite).
+        /// </summary>
+        public async Task TouchLastLoginAsync(int userId)
+        {
+            try
+            {
+                await _context.Users
+                    .Where(u => u.Id == userId)
+                    .ExecuteUpdateAsync(setters => setters.SetProperty(u => u.LastLoginAt, DateTime.UtcNow));
+            }
+            catch (Exception ex)
+            {
+                // Never fail a sign-in because a timestamp could not be written.
+                _logger.LogWarning(ex, "Could not update LastLoginAt for user ID {UserId}.", userId);
+            }
+        }
+
+        /// <summary>
+        /// Detects a PostgreSQL unique-constraint violation (SQLSTATE 23505), possibly wrapped.
+        /// </summary>
+        private static bool IsUniqueViolation(Exception ex)
+        {
+            for (var current = ex; current != null; current = current.InnerException)
+            {
+                if (current is Npgsql.PostgresException pg && pg.SqlState == "23505")
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        #endregion
     }
 }
