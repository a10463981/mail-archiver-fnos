+                        user.Username,
+                        AccessLogType.Account,
+                        searchParameters: $"link fnOS uid={uid} name={username}");
+                    _logger.LogInformation("Linked fnOS uid {Uid} to account {Username}.", uid, user.Username);
+                    break;
+
+                case GatewayBindResult.AccountAlreadyBound:
