diff --git a/Services/UnixSocketPermissionService.cs b/Services/UnixSocketPermissionService.cs
new file mode 100644
index 0000000..5215a3b
--- /dev/null
+++ b/Services/UnixSocketPermissionService.cs
@@ -0,0 +1,84 @@
+namespace MailArchiver.Services
+{
+    /// <summary>
+    /// Tightens the Kestrel unix domain socket to <c>0600</c> once it exists.
+    ///
+    /// Why this matters: the fnOS gateway injects the caller's identity as HTTP headers, and the
+    /// application trusts them. Kestrel creates the socket with the process umask (typically
+    /// 0666), which would let any other local application user connect directly and forge those
+    /// headers. The gateway itself runs as root, so restricting the socket to the owning user
+    /// costs nothing and removes that entire attack surface.
+    ///
+    /// The socket is created by Kestrel after hosted services have started, so this service polls
+    /// briefly instead of assuming the file already exists.
+    /// </summary>
+    public class UnixSocketPermissionService : BackgroundService
+    {
+        private readonly string _socketPath;
+        private readonly ILogger<UnixSocketPermissionService> _logger;
+
+        public UnixSocketPermissionService(string socketPath, ILogger<UnixSocketPermissionService> logger)
+        {
+            _socketPath = socketPath;
+            _logger = logger;
+        }
+
+        protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+        {
+            if (!OperatingSystem.IsLinux() && !OperatingSystem.IsMacOS() && !OperatingSystem.IsFreeBSD())
+            {
+                return;
+            }
+
+            var deadline = DateTime.UtcNow.AddSeconds(30);
+
+            while (!stoppingToken.IsCancellationRequested && DateTime.UtcNow < deadline)
+            {
+                try
+                {
+                    // chmod on the socket path. FileNotFoundException simply means Kestrel has not
+                    // bound it yet, so keep polling.
+                    File.SetUnixFileMode(
+                        _socketPath,
+                        UnixFileMode.UserRead | UnixFileMode.UserWrite);
+
+                    _logger.LogInformation(
+                        "Unix socket '{SocketPath}' permissions tightened to 0600 (owner only).", _socketPath);
+                    return;
+                }
+                catch (FileNotFoundException)
+                {
+                    // not created yet
+                }
+                catch (DirectoryNotFoundException)
+                {
+                    // parent directory not created yet
+                }
+                catch (Exception ex)
+                {
+                    _logger.LogWarning(
+                        ex,
+                        "Could not set permissions on unix socket '{SocketPath}'. " +
+                        "The fpk lifecycle script must apply 'chmod 0600' instead.", _socketPath);
+                    return;
+                }
+
+                try
+                {
+                    await Task.Delay(100, stoppingToken);
+                }
+                catch (OperationCanceledException)
+                {
+                    return;
+                }
+            }
+
+            if (!stoppingToken.IsCancellationRequested)
+            {
+                _logger.LogWarning(
+                    "Unix socket '{SocketPath}' did not appear within 30s; permissions were NOT tightened. " +
+                    "Verify the fpk lifecycle script applies 'chmod 0600'.", _socketPath);
+            }
+        }
+    }
+}
