@@ -0,0 +1,64 @@
+namespace MailArchiver.Auth.Options
+{
+    /// <summary>
+    /// Configuration for the fnOS ("飞牛") gateway identity bridge.
+    ///
+    /// The fnOS unified gateway authenticates the NAS session itself and then forwards the
+    /// request to this application over a unix domain socket, injecting the caller's identity
+    /// as HTTP headers. Because the application listens on a 0600 unix socket and publishes no
+    /// TCP port, "request arrived on the socket" is the trust boundary; these options only
+    /// describe how to read the injected identity.
+    ///
+    /// DELIBERATELY ABSENT: there is no admin/role option here. The gateway also sends
+    /// <c>X-Trim-Isadmin</c>, but this application does NOT read it and does NOT map it onto
+    /// <see cref="Models.User.IsAdmin"/>. Authorisation is decided solely by the local
+    /// Mail Archiver account. Do not add role mapping here without a separate design review.
+    /// </summary>
+    public class GatewayOptions
+    {
+        public const string Gateway = "Gateway";
+
+        /// <summary>Master switch. When false the middleware is a no-op and behaviour is
+        /// byte-for-byte identical to upstream.</summary>
+        public bool Enabled { get; set; } = false;
+
+        /// <summary>
+        /// Optional shared secret. Empty (default) means "skip the check" — correct for the
+        /// single-container fpk where the unix socket permission is the only trust boundary.
+        /// Set this only when a sidecar/proxy sits in front and can inject the header.
+        /// </summary>
+        public string? SharedSecret { get; set; }
+
+        /// <summary>Header carrying <see cref="SharedSecret"/>. Ignored when the secret is empty.</summary>
+        public string SharedSecretHeader { get; set; } = "X-Gateway-Secret";
+
+        /// <summary>Header carrying the fnOS OS uid. This is the ONLY identity key.</summary>
+        public string UserIdHeader { get; set; } = "X-Trim-Userid";
+
+        /// <summary>
+        /// Header carrying the fnOS user name. DISPLAY ONLY — it is a snapshot taken at fnOS
+        /// login time (it goes stale after a rename) and may contain non-ASCII characters, so it
+        /// must never be used as a lookup key.
+        /// </summary>
+        public string UsernameHeader { get; set; } = "X-Trim-Username";
+
+        /// <summary>
+        /// Where to send the browser after sign-out. Empty means "back to the application root",
+        /// which lands on the login page with the auto-login suppressed for
+        /// <see cref="LogoutSuppressionSeconds"/>.
+        /// </summary>
+        public string LogoutRedirectUrl { get; set; } = "";
+
+        /// <summary>
+        /// How long auto-login stays suppressed after an explicit sign-out. The gateway injects
+        /// the identity on every request, so without this window the user could never sign out.
+        /// </summary>
+        public int LogoutSuppressionSeconds { get; set; } = 60;
+
+        /// <summary>
+        /// Prefix stored in <see cref="Models.User.OAuthRemoteUserId"/> so that a gateway subject
+        /// can never collide with an OIDC subject (which is stored bare).
+        /// </summary>
+        public string SubjectPrefix { get; set; } = "fnos:";
+    }
+}
