+// The fnOS unified gateway connects to ${TRIM_APPDEST}/app.sock and publishes no TCP port,
+// so the socket's file permissions are the only trust boundary for the injected identity
+// headers. When LISTEN_UNIX_SOCKET is unset the upstream behaviour (ASPNETCORE_URLS) is kept,
+// which is what you want for local development.
+var listenUnixSocket = Environment.GetEnvironmentVariable("LISTEN_UNIX_SOCKET");
+if (!string.IsNullOrWhiteSpace(listenUnixSocket))
+{
