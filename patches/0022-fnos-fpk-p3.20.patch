+                account = await userService.GetUserByIdAsync(userId);
+            }
+            catch (Exception ex)
+            {
+                // Availability first: a database hiccup must not sign everybody out.
+                _logger.LogWarning(ex, "Could not re-validate session for user {UserId}; continuing.", userId);
+                return;
+            }
+
+            if (account == null || !account.IsActive || account.RequiresApproval)
+            {
+                _logger.LogWarning(
+                    "Session denied (session-revalidation-failed): user {UserId} is {State}. Signing out.",
+                    userId,
+                    account == null ? "missing" : (!account.IsActive ? "disabled" : "pending approval"));
+
+                await context.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
+                context.User = new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
+                return;
+            }
+
+            // Healthy: refresh the timestamp so the next interval starts now — WITHOUT changing the
+            // session's lifetime semantics. Re-issuing with a fresh ExpiresUtc on every re-validation
+            // would silently turn a 60-minute session into one that never expires, and forcing
+            // IsPersistent=false would quietly drop "remember me" for anyone who ticked it.
+            // Re-issuing must only refresh "chk". Every identity-bearing claim has to survive:
+            // dropping "luid" here (it happened) made the middleware treat the very same person as a
+            // stranger on the next request, so an unlinked administrator was signed out to the consent
+            // page every SessionRevalidateSeconds — a deadlock on a timer.
