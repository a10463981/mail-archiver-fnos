+@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
+@{
+    ViewData["Title"] = Localizer["ConsentTitle"];
+    Layout = "_LoginLayout";
+    var userName = ViewBag.ConsentUserName as string ?? "";
+    var uid = ViewBag.ConsentUid as string ?? "";
+    var returnUrl = ViewBag.ConsentReturnUrl as string ?? "/";
+}
+<div class="login-container">
+    <div class="card login-card">
+        <div class="card-body">
+            <div class="text-center mb-4">
+                <i class="bi bi-shield-lock display-3 text-primary"></i>
+                <h2 class="mt-3">@Localizer["ConsentTitle"]</h2>
+                <p class="text-muted mb-0">@Localizer["ConsentSubtitle"]</p>
+            </div>
+
+            <div class="alert alert-info" role="alert">
+                <div class="fw-semibold mb-1">@Localizer["ConsentIdentityLabel"]</div>
+                <div>@Localizer["ConsentIdentityValue", userName, uid]</div>
+            </div>
+
+            <ul class="list-unstyled small mb-4">
+                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>@Localizer["ConsentScopeIdentity"]</li>
+                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>@Localizer["ConsentScopeNoData"]</li>
+                <li class="mb-2"><i class="bi bi-x-circle-fill text-danger me-2"></i>@Localizer["ConsentScopeNoPassword"]</li>
+            </ul>
+
+            <form asp-action="ConsentDecision" method="post" class="d-grid gap-2">
+                <input type="hidden" name="returnUrl" value="@returnUrl" />
+                <input type="hidden" name="decision" value="allow" />
+                <button type="submit" class="btn btn-primary btn-lg">
+                    <i class="bi bi-check-lg me-2"></i>@Localizer["ConsentAgree"]
+                </button>
+            </form>
+
+            <form asp-action="ConsentDecision" method="post" class="d-grid gap-2 mt-2">
+                <input type="hidden" name="returnUrl" value="@returnUrl" />
+                <input type="hidden" name="decision" value="deny" />
+                <button type="submit" class="btn btn-outline-secondary">
+                    <i class="bi bi-x-lg me-2"></i>@Localizer["ConsentDeny"]
+                </button>
+            </form>
+
+            <p class="text-muted small mb-0 mt-3 text-center">@Localizer["ConsentDenyNote"]</p>
+        </div>
+    </div>
+</div>
