+namespace MailArchiver.Models
+{
+    /// <summary>
+    /// Outcome of attempting to link an fnOS identity to a local Mail Archiver account.
+    /// </summary>
+    public enum GatewayBindResult
+    {
+        /// <summary>The link was written.</summary>
+        Success,
+
+        /// <summary>The account is already linked to this very subject — treated as success.</summary>
+        AlreadyBoundToSame,
+
+        /// <summary>The local account is already linked to a different fnOS user.</summary>
+        AccountAlreadyBound,
+
+        /// <summary>The fnOS user is already linked to a different local account.</summary>
+        SubjectAlreadyBound,
+
+        /// <summary>No such local account.</summary>
+        UserNotFound,
+
+        /// <summary>The subject was empty or malformed.</summary>
+        InvalidSubject
+    }
+}
+
+namespace MailArchiver.Models
+{
+    /// <summary>
+    /// Outcome of removing an fnOS link from a local account.
+    ///
+    /// Unlinking re-enables the password channel, so it cannot by itself reduce the number of
+    /// reachable administrators — except when the account has no password at all: then unlinking
+    /// turns it into an account nobody can sign in with. That is the case the guard refuses, so an
+    /// installation can never end up with an administrator it has no way to log in as.
+    /// </summary>
+    public enum GatewayUnbindOutcome
+    {
+        /// <summary>The link was removed.</summary>
+        Success,
+
+        /// <summary>No such account.</summary>
+        UserNotFound,
+
+        /// <summary>The account had no link to remove.</summary>
+        NotLinked,
+
+        /// <summary>
+        /// Refused: this administrator has no password, so unlinking would leave it unreachable.
+        /// </summary>
+        AdministratorWithoutPassword,
+
+        /// <summary>
+        /// Refused: it is the only administrator left that can still sign in with a password.
+        /// </summary>
+        LastReachableAdministrator
+    }
+}
