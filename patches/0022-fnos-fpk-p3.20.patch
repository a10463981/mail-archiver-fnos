diff --git a/Services/SocketSecurityState.cs b/Services/SocketSecurityState.cs
new file mode 100644
index 0000000..92dec4c
--- /dev/null
+++ b/Services/SocketSecurityState.cs
@@ -0,0 +1,51 @@
+namespace MailArchiver.Services
+{
+    /// <summary>
+    /// Runtime state of the unix-socket hardening.
+    ///
+    /// Why this exists: when the app listens on a unix socket, the socket's file mode is the ONLY
+    /// trust boundary for the identity headers injected by the fnOS gateway. If the socket cannot
+    /// be tightened to owner-only, the gateway bridge must stop trusting those headers instead of
+    /// silently continuing — "any local process can become any user" is not an acceptable
+    /// degradation.
+    ///
+    /// The state is recoverable: <see cref="UnixSocketPermissionService"/> keeps retrying and flips
+    /// this back to hardened as soon as it succeeds, so a permission problem fixed on the host does
+    /// not require restarting the container.
+    ///
+    /// Registered as a singleton; all fields are volatile because the writer is a background
+    /// service and the readers are request threads.
+    /// </summary>
+    public class SocketSecurityState
+    {
+        private volatile bool _hardened;
+        private volatile bool _hardeningFailed;
+        private volatile string? _socketPath;
+
+        /// <summary>True once the socket mode has been confirmed as owner-only (0600).</summary>
+        public bool IsHardened => _hardened;
+
+        /// <summary>
+        /// True when tightening was attempted and failed. The gateway bridge treats this as
+        /// fail-closed: it refuses to authenticate from headers rather than run unprotected.
+        /// Cleared automatically when a later retry succeeds.
+        /// </summary>
+        public bool HardeningFailed => _hardeningFailed;
+
+        public string? SocketPath => _socketPath;
+
+        public void MarkHardened(string socketPath)
+        {
+            _socketPath = socketPath;
+            _hardened = true;
+            _hardeningFailed = false;
+        }
+
+        public void MarkFailed(string socketPath)
+        {
+            _socketPath = socketPath;
+            _hardened = false;
+            _hardeningFailed = true;
+        }
+    }
+}
diff --git a/Services/UnixSocketPermissionService.cs b/Services/UnixSocketPermissionService.cs
new file mode 100644
index 0000000..6f38114
--- /dev/null
+++ b/Services/UnixSocketPermissionService.cs
@@ -0,0 +1,154 @@
+namespace MailArchiver.Services
+{
+    /// <summary>
+    /// Keeps the Kestrel unix domain socket at <c>0600</c> and records the outcome in
+    /// <see cref="SocketSecurityState"/>.
+    ///
+    /// Why this matters: the fnOS gateway injects the caller's identity as HTTP headers and the
+    /// application trusts them. The socket's file mode is the only thing between those headers and
+    /// any other local process. Two layers are used:
+    ///   1. the container entrypoint runs with <c>umask 0077</c>, so the socket is created
+    ///      owner-only (0666 &amp; ~0077 = 0600) while directories stay traversable (0700);
+    ///   2. this service re-applies the mode and keeps watching.
+    ///
+    /// Failure is NOT terminal and NOT silent:
+    ///   * the gateway bridge stops trusting headers while the state is failed (fail-closed);
+    ///   * this loop keeps retrying, so fixing the permissions on the host clears the condition
+    ///     without restarting the container;
+    ///   * a failure is logged at Error once, repeats at Debug, and recovery at Information, so a
+    ///     broken deployment does not flood the log.
+    /// </summary>
+    public class UnixSocketPermissionService : BackgroundService
+    {
+        /// <summary>Retry cadence while the socket is unhealthy or missing.</summary>
+        private static readonly TimeSpan RetryInterval = TimeSpan.FromSeconds(2);
+
+        /// <summary>Re-check cadence once the socket is known good (cheap, no log noise).</summary>
+        private static readonly TimeSpan HealthyInterval = TimeSpan.FromSeconds(30);
+
+        /// <summary>
+        /// Grace period before "socket still has not appeared" is escalated to a failure. Kestrel
+        /// binds shortly after start-up; a slow disk can take a few seconds. Retrying continues, so
+        /// the escalation is reversible.
+        /// </summary>
+        private static readonly TimeSpan AppearanceGrace = TimeSpan.FromSeconds(30);
+
+        private readonly string _socketPath;
+        private readonly SocketSecurityState _state;
+        private readonly ILogger<UnixSocketPermissionService> _logger;
+
+        private bool _failureReported;
+
+        public UnixSocketPermissionService(
+            string socketPath,
+            SocketSecurityState state,
+            ILogger<UnixSocketPermissionService> logger)
+        {
+            _socketPath = socketPath;
+            _state = state;
+            _logger = logger;
+        }
+
+        protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+        {
+            if (!OperatingSystem.IsLinux() && !OperatingSystem.IsMacOS() && !OperatingSystem.IsFreeBSD())
+            {
+                return;
+            }
+
+            var startedAt = DateTime.UtcNow;
+
+            while (!stoppingToken.IsCancellationRequested)
+            {
+                var wasHardened = _state.IsHardened;
+
+                try
+                {
+                    File.SetUnixFileMode(
+                        _socketPath,
+                        UnixFileMode.UserRead | UnixFileMode.UserWrite);
+
+                    _state.MarkHardened(_socketPath);
+
+                    if (!wasHardened)
+                    {
+                        if (_failureReported)
+                        {
+                            _logger.LogInformation(
+                                "Unix socket '{SocketPath}' is owner-only (0600) again. " +
+                                "Gateway header authentication has been re-enabled (no restart needed).",
+                                _socketPath);
+                        }
+                        else
+                        {
+                            _logger.LogInformation(
+                                "Unix socket '{SocketPath}' is owner-only (0600) — gateway headers will be trusted.",
+                                _socketPath);
+                        }
+                    }
+
+                    _failureReported = false;
+                    await DelayAsync(HealthyInterval, stoppingToken);
+                    continue;
+                }
+                catch (OperationCanceledException)
+                {
+                    return;
+                }
+                catch (FileNotFoundException)
+                {
+                    if (DateTime.UtcNow - startedAt > AppearanceGrace)
+                    {
+                        ReportFailure("it has not appeared yet");
+                    }
+                }
+                catch (DirectoryNotFoundException)
+                {
+                    if (DateTime.UtcNow - startedAt > AppearanceGrace)
+                    {
+                        ReportFailure("its parent directory does not exist");
+                    }
+                }
+                catch (Exception ex)
+                {
+                    ReportFailure(ex.Message);
+                }
+
+                await DelayAsync(RetryInterval, stoppingToken);
+            }
+        }
+
+        private void ReportFailure(string reason)
+        {
+            _state.MarkFailed(_socketPath);
+
+            if (_failureReported)
+            {
+                _logger.LogDebug(
+                    "Unix socket '{SocketPath}' is still not owner-only ({Reason}); still retrying.",
+                    _socketPath, reason);
+                return;
+            }
+
+            _failureReported = true;
+            _logger.LogError(
+                "Could not restrict unix socket '{SocketPath}' to 0600 ({Reason}). " +
+                "Gateway header authentication is REFUSED (fail-closed) until this is fixed. " +
+                "The check retries every {Seconds}s and recovers by itself once the permissions " +
+                "can be set — no restart required. Password sign-in on /Auth/Login is unaffected.",
+                _socketPath, reason, (int)RetryInterval.TotalSeconds);
+        }
+
+        private static async Task DelayAsync(TimeSpan delay, CancellationToken stoppingToken)
+        {
+            try
+            {
+                await Task.Delay(delay, stoppingToken);
+            }
+            catch (OperationCanceledException)
+            {
+                // Shutting down: swallow so the loop can exit cleanly.
+            }
+        }
+    }
+}
