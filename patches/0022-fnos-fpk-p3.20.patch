+        /// <summary>
+        /// Identity claims that must be carried across a re-issue: the gateway subject of a
+        /// gateway-issued session, and the fnOS uid that was present when a password session was
+        /// created. Both are written once at sign-in and never change afterwards.
+        /// </summary>
+        internal readonly record struct IdentityClaims(string? GatewaySubject, string? LoginUid)
+        {
+            public bool IsEmpty => string.IsNullOrEmpty(GatewaySubject) && string.IsNullOrEmpty(LoginUid);
+        }
+
+        internal static IdentityClaims CaptureIdentityClaims(System.Security.Claims.ClaimsPrincipal? principal)
+        {
+            return new IdentityClaims(
+                principal?.FindFirst(MailArchiver.Auth.Middlewares.GatewayAuthMiddleware.SubjectClaimType)?.Value,
+                principal?.FindFirst(MailArchiver.Auth.Services.CookieAuthenticationService.LoginUidClaimType)?.Value);
+        }
+
+        /// <summary>
+        /// Rebuilds the principal for an existing session. The identity claims are passed as a single
+        /// snapshot ON PURPOSE: the previous two-parameter signature made it possible to "just not
+        /// pass" one of them, which silently dropped a claim and only showed up as users being signed
+        /// out minutes later. Anything added here must be threaded through explicitly.
+        /// </summary>
+        internal static System.Security.Claims.ClaimsPrincipal? BuildPrincipalThroughService(
+            HttpContext context, MailArchiver.Models.User account, IdentityClaims identity)
+        {
+            var service = context.RequestServices.GetService<MailArchiver.Services.IAuthenticationService>();
+            if (service == null)
+            {
+                return null;
+            }
+
+            var rebuilt = service.BuildPrincipal(account, identity.GatewaySubject, identity.LoginUid);
+
+            // Defence in depth: if a future edit loses a claim, fail loudly instead of letting the
+            // session quietly change identity.
+            var after = CaptureIdentityClaims(rebuilt);
+            if (after != identity)
+            {
+                throw new InvalidOperationException(
+                    $"Re-issued session would change the identity claims (before={identity}, after={after}).");
+            }
