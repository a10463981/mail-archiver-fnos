+        /// <summary>
+        /// Re-checks the account behind an existing session once the "chk" claim is older than the
+        /// configured interval. A disabled (or pending-approval) account is signed out on the spot, so
+        /// deactivating someone does not have to wait for the cookie to expire; a healthy account gets
+        /// a refreshed cookie with a new timestamp.
+        ///
+        /// Cost: one primary-key lookup per session per interval (default 5 minutes), not per request.
+        /// </summary>
+        private async Task RevalidateSessionIfStaleAsync(
+            HttpContext context,
+            IUserService userService,
+            MailArchiver.Models.AuthenticationOptions options)
+        {
+            if (context.User?.Identity?.IsAuthenticated != true)
+            {
+                return;
+            }
+
+            var interval = Math.Max(0, options.SessionRevalidateSeconds);
+            var checkedClaim = context.User.FindFirst(
+                MailArchiver.Auth.Services.CookieAuthenticationService.SessionCheckedClaimType)?.Value;
+
+            if (long.TryParse(checkedClaim, out var checkedAt))
+            {
+                var age = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - checkedAt;
+                if (age < interval)
+                {
+                    return;
+                }
+            }
+
+            var userIdClaim = context.User.FindFirst("UserId")?.Value;
+            if (!int.TryParse(userIdClaim, out var userId))
+            {
+                return;
+            }
