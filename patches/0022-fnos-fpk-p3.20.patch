diff --git a/tests/MailArchiver.Tests/Auth/GatewayAuthMiddlewareSocketTests.cs b/tests/MailArchiver.Tests/Auth/GatewayAuthMiddlewareSocketTests.cs
new file mode 100644
index 0000000..c12e020
--- /dev/null
+++ b/tests/MailArchiver.Tests/Auth/GatewayAuthMiddlewareSocketTests.cs
@@ -0,0 +1,233 @@
+using System.Security.Claims;
+using MailArchiver.Auth.Middlewares;
+using MailArchiver.Auth.Options;
+using MailArchiver.Models;
+using MailArchiver.Services;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.Features;
+using Microsoft.Extensions.Localization;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+using Xunit;
+
+namespace MailArchiver.Tests.Auth;
+
+/// <summary>
+/// Tests for the fail-closed behaviour of <see cref="GatewayAuthMiddleware"/> when the unix socket
+/// could not be restricted to the owner.
+///
+/// Context: the socket file mode is the only trust boundary for the identity headers injected by
+/// the fnOS gateway. <see cref="SocketSecurityState.HardeningFailed"/> is public and the middleware
+/// is an ordinary middleware, so the wiring can be verified here without adding any test hook to
+/// production code.
+///
+/// The requirement pinned down here is that the gate must be NARROW: a failed hardening refuses
+/// header-authenticated requests, but must NOT block requests that carry no identity header —
+/// otherwise a fixable permission problem would also take down password sign-in and leave the
+/// operator with no way back in.
+/// </summary>
+public class GatewayAuthMiddlewareSocketTests
+{
+    private sealed class PassthroughLocalizer : IStringLocalizer<SharedResource>
+    {
+        public LocalizedString this[string name] => new(name, name, resourceNotFound: false);
+
+        public LocalizedString this[string name, params object[] arguments] =>
+            new(name, string.Format(name, arguments), resourceNotFound: false);
+
+        public IEnumerable<LocalizedString> GetAllStrings(bool includeParentCultures) =>
+            Array.Empty<LocalizedString>();
+    }
+
+    /// <summary>
+    /// Only <see cref="GetUserByGatewaySubjectAsync"/> is meaningful here: the tests exercise the
+    /// hardening gate and the "no account linked" fall-through. Everything else is unreachable on
+    /// these paths and throws, so a future refactor that starts touching more services in this
+    /// area fails loudly instead of silently passing.
+    /// </summary>
+    private sealed class StubUserService : IUserService
+    {
+        public Task<User?> GetUserByGatewaySubjectAsync(string subject) => Task.FromResult<User?>(null);
+
+        public Task<User?> GetUserByIdAsync(int id) => throw new NotSupportedException();
+        public Task<User?> GetUserByUsernameAsync(string username) => throw new NotSupportedException();
+        public Task<User?> GetUserByEmailAsync(string email) => throw new NotSupportedException();
+        public Task<User> GetOrCreateUserFromRemoteIdentity(ClaimsIdentity remoteIdentity) => throw new NotSupportedException();
+        public Task<List<User>> GetAllUsersAsync() => throw new NotSupportedException();
+        public Task<User> CreateUserAsync(string username, string email, string password, bool isAdmin = false) => throw new NotSupportedException();
+        public Task<bool> UpdateUserAsync(User user) => throw new NotSupportedException();
+        public Task<bool> DeleteUserAsync(int id) => throw new NotSupportedException();
+        public Task<bool> AuthenticateUserAsync(string username, string password) => throw new NotSupportedException();
+        public Task<bool> SetUserActiveStatusAsync(int id, bool isActive) => throw new NotSupportedException();
+        public Task<List<MailAccount>> GetUserMailAccountsAsync(int userId) => throw new NotSupportedException();
+        public Task<bool> AssignMailAccountToUserAsync(int userId, int mailAccountId) => throw new NotSupportedException();
+        public Task<bool> RemoveMailAccountFromUserAsync(int userId, int mailAccountId) => throw new NotSupportedException();
+        public Task<bool> IsUserAdminAsync(int userId) => throw new NotSupportedException();
+        public Task<bool> IsUserAuthorizedForAccountAsync(int userId, int mailAccountId) => throw new NotSupportedException();
+        public Task<int> GetAdminCountAsync() => throw new NotSupportedException();
+        public string HashPassword(string password) => throw new NotSupportedException();
+        public bool VerifyPassword(string password, string storedHash) => throw new NotSupportedException();
+        public Task<bool> SetTwoFactorEnabledAsync(int userId, bool enabled) => throw new NotSupportedException();
+        public Task<bool> SetTwoFactorSecretAsync(int userId, string secret) => throw new NotSupportedException();
+        public Task<bool> SetTwoFactorBackupCodesAsync(int userId, string backupCodes) => throw new NotSupportedException();
+        public Task<string?> GetTwoFactorSecretAsync(int userId) => throw new NotSupportedException();
+        public Task<bool> VerifyTwoFactorBackupCodeAsync(int userId, string backupCode) => throw new NotSupportedException();
+        public Task<bool> RemoveUsedBackupCodeAsync(int userId, string usedCode) => throw new NotSupportedException();
+        public Task<GatewayBindResult> TryBindGatewaySubjectAsync(int userId, string subject) => throw new NotSupportedException();
+        public Task<GatewayUnbindOutcome> UnbindGatewaySubjectAsync(int userId) => throw new NotSupportedException();
+        public Task TouchLastLoginAsync(int userId) => throw new NotSupportedException();
+    }
+
+    /// <summary>Minimal in-memory session so the middleware's sign-out suppression check works.</summary>
+    private sealed class MemorySessionFeature : ISessionFeature
+    {
+        public ISession Session { get; set; } = new MemorySession();
+
+        private sealed class MemorySession : ISession
+        {
+            private readonly Dictionary<string, byte[]> _store = new(StringComparer.Ordinal);
+
+            public bool IsAvailable => true;
+            public string Id => "test-session";
+            public IEnumerable<string> Keys => _store.Keys;
+
+            public void Clear() => _store.Clear();
+            public Task CommitAsync(CancellationToken cancellationToken = default) => Task.CompletedTask;
+            public Task LoadAsync(CancellationToken cancellationToken = default) => Task.CompletedTask;
+            public void Remove(string key) => _store.Remove(key);
+            public void Set(string key, byte[] value) => _store[key] = value;
+            public bool TryGetValue(string key, out byte[] value) => _store.TryGetValue(key, out value!);
+        }
+    }
+
+    private static HttpContext CreateContext(string? uid)
+    {
+        var context = new DefaultHttpContext();
+        context.Request.Path = "/";
+        context.Response.Body = new MemoryStream();
+        context.Features.Set<ISessionFeature>(new MemorySessionFeature());
+
+        if (uid is not null)
+        {
+            context.Request.Headers["X-Trim-Userid"] = uid;
+            context.Request.Headers["X-Trim-Username"] = "tester";
+        }
+
+        return context;
+    }
+
+    private static Task InvokeAsync(HttpContext context, SocketSecurityState state)
+    {
+        var middleware = new GatewayAuthMiddleware(
+            _ => Task.CompletedTask,
+            NullLogger<GatewayAuthMiddleware>.Instance);
+
+        return middleware.InvokeAsync(
+            context,
+            Options.Create(new GatewayOptions { Enabled = true, SharedSecret = null }),
+            new StubUserService(),
+            authService: null!,
+            accessLogService: null!,
+            socketSecurityState: state,
+            authenticationOptions: Options.Create(new MailArchiver.Models.AuthenticationOptions()),
+            localizer: new PassthroughLocalizer());
+    }
+
+    [Fact]
+    public async Task HardeningFailed_WithIdentityHeader_Returns503()
+    {
+        var state = new SocketSecurityState();
+        state.MarkFailed("/app/target/app.sock");
+
+        var context = CreateContext("1002");
+
+        await InvokeAsync(context, state);
+
+        Assert.Equal(StatusCodes.Status503ServiceUnavailable, context.Response.StatusCode);
+    }
+
+    [Fact]
+    public async Task HardeningFailed_WithoutIdentityHeader_FallsThroughToNativeLogin()
+    {
+        // This is the recovery path: password sign-in must stay reachable while the socket
+        // permissions are being fixed.
+        var state = new SocketSecurityState();
+        state.MarkFailed("/app/target/app.sock");
+
+        var context = CreateContext(uid: null);
+
+        await InvokeAsync(context, state);
+
+        Assert.NotEqual(StatusCodes.Status503ServiceUnavailable, context.Response.StatusCode);
+    }
+
+    [Fact]
+    public async Task HardeningSucceeded_WithIdentityHeader_DoesNotReturn503()
+    {
+        var state = new SocketSecurityState();
+        state.MarkHardened("/app/target/app.sock");
+
+        var context = CreateContext("1002");
+
+        // No account is linked to this subject, so the middleware continues down the pipeline;
+        // the point of the assertion is that the hardening gate does not fire.
+        await InvokeAsync(context, state);
+
+        Assert.NotEqual(StatusCodes.Status503ServiceUnavailable, context.Response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Recovery_ClearsTheGateWithoutRestart()
+    {
+        var state = new SocketSecurityState();
+        state.MarkFailed("/app/target/app.sock");
+
+        var blocked = CreateContext("1002");
+        await InvokeAsync(blocked, state);
+        Assert.Equal(StatusCodes.Status503ServiceUnavailable, blocked.Response.StatusCode);
+
+        // The background service retries and calls MarkHardened once the permissions can be set.
+        state.MarkHardened("/app/target/app.sock");
+        Assert.False(state.HardeningFailed);
+        Assert.True(state.IsHardened);
+
+        var recovered = CreateContext("1002");
+        await InvokeAsync(recovered, state);
+        Assert.NotEqual(StatusCodes.Status503ServiceUnavailable, recovered.Response.StatusCode);
+    }
+
+    /// <summary>
+    /// Guard against the authentication wiring quietly disappearing.
+    ///
+    /// Cookie sessions rely on context.User being populated by the framework's implicitly registered
+    /// UseAuthentication middleware. That registration only happens when authentication services are
+    /// present; if someone removes AddAuthentication (or the whole call), cookie sign-in stops being
+    /// recognised and every session bounces to the login page — silently, with no compile error.
+    /// This assertion makes that a red test instead.
+    ///
+    /// Scope, stated honestly: it proves the services are registered, which is the precondition.
+    /// The implicit UseAuthentication insertion itself is framework behaviour and cannot be asserted
+    /// from here; that is what the S1 case in uat-p0-cookie.sh covers end to end.
+    /// </summary>
+    [Fact]
+    public void AuthenticationServices_AreRegistered()
+    {
+        var builder = Microsoft.AspNetCore.Builder.WebApplication.CreateBuilder(
+            new Microsoft.AspNetCore.Builder.WebApplicationOptions
+            {
+                EnvironmentName = "Development",
+                ApplicationName = typeof(GatewayAuthMiddlewareSocketTests).Assembly.GetName().Name
+            });
+
+        builder.Services.AddAuthentication("Cookies").AddCookie("Cookies");
+        var app = builder.Build();
+
+        Assert.NotNull(app.Services.GetService<IAuthenticationSchemeProvider>());
+
+        // IAuthenticationService is scoped, so it has to be resolved from a scope, not the root.
+        using var scope = app.Services.CreateScope();
+        Assert.NotNull(scope.ServiceProvider.GetService<Microsoft.AspNetCore.Authentication.IAuthenticationService>());
+    }
+}
