index 0000000..fa7b063
--- /dev/null
+++ b/Auth/Middelwares/GatewayAuthMiddleware.cs
@@ -0,0 +1,536 @@
+using System.Security.Claims;
+using System.Text;
+using MailArchiver.Auth.Options;
+using MailArchiver.Models;
+using MailArchiver.Services;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.Cookies;
+using Microsoft.Extensions.Localization;
+using Microsoft.Extensions.Options;
+
+namespace MailArchiver.Auth.Middlewares
+{
+    /// <summary>
+    /// Sign-in bridge for the fnOS ("飞牛") unified gateway.
+    ///
+    /// Responsibility (and nothing more): if the request carries an fnOS uid that is already
+    /// linked to a local account, sign that account in and continue. It never creates accounts,
+    /// never changes roles, and never grants anything based on the gateway's admin header.
+    ///
+    /// Unbound identities are deliberately NOT handled here: the request falls through to the
+    /// normal pipeline, which redirects to the native login page. That page shows a hint and
+    /// performs the link once the user proves ownership of the local account with its password.
+    ///
+    /// Security invariants (see also the fpk delivery notes):
+    ///  * missing / malformed identity header  -> fall through to the native login flow
+    ///    (fall through is NOT authentication: the downstream AuthenticationMiddleware still
+    ///    redirects, so a caller without headers can never be treated as a user);
+    ///  * <c>X-Trim-Isadmin</c> is never read — authorisation comes from the local account only;
+    ///  * a disabled or pending local account is rejected, and those flags are never mutated here;
+    ///  * a native (password) session is never hijacked — that is the break-glass path.
+    /// </summary>
+    public class GatewayAuthMiddleware
+    {
+        /// <summary>
+        /// Cookie that remembers a *declined* consent decision, so the prompt is not shown again on
+        /// every visit. Chosen over a session entry because a session dies with the browser and the
+        /// user would be asked again on the next launch; 24h is long enough not to nag, short enough
+        /// that a mis-click is not permanent, and the login page offers an explicit way to re-open
+        /// the prompt.
+        /// </summary>
+        public const string ConsentCookieName = ".MailArchiverFnosConsent";
+
+        /// <summary>Cookie value meaning "the user declined the fnOS identity".</summary>
+        public const string ConsentDeclinedValue = "decline";
+
+        /// <summary>
+        /// Cookie value meaning "the user allowed it, but has not linked an account yet".
+        /// Remembering the allow as well keeps the prompt from reappearing on every visit while the
+        /// user has still to complete the one-time link on the login page.
+        /// </summary>
+        public const string ConsentAllowedValue = "allow";
+
+        /// <summary>Session key holding the unix-seconds timestamp of the last explicit sign-out.</summary>
+        public const string LogoutSuppressedAtKey = "GatewayLogoutSuppressedAt";
+
+        /// <summary>Claim stamped on gateway-issued sessions so they can be told apart from password sessions.</summary>
+        public const string SubjectClaimType = "gw_sub";
+
+        private readonly RequestDelegate _next;
+        private readonly ILogger<GatewayAuthMiddleware> _logger;
+
+        public GatewayAuthMiddleware(RequestDelegate next, ILogger<GatewayAuthMiddleware> logger)
+        {
+            _next = next;
+            _logger = logger;
+        }
+
+        public async Task InvokeAsync(
+            HttpContext context,
+            IOptions<GatewayOptions> gatewayOptions,
+            IUserService userService,
+            // Fully qualified: Microsoft.AspNetCore.Authentication also declares an IAuthenticationService.
+            MailArchiver.Services.IAuthenticationService authService,
+            IAccessLogService accessLogService,
+            SocketSecurityState socketSecurityState,
+            IOptions<MailArchiver.Models.AuthenticationOptions> authenticationOptions,
+            IStringLocalizer<SharedResource> localizer)
+        {
+            var options = gatewayOptions.Value;
+            if (!options.Enabled)
+            {
+                await _next(context);
+                return;
+            }
+
+            // The native auth endpoints must stay reachable without gateway auto-login:
+            //  - /Auth/Login  is where an unbound user proves account ownership and links it,
+            //  - /Auth/Logout must run before any re-sign-in,
+            //  - /Auth/Blocked, /TwoFactor are part of the native flows.
+            //
+            // /TwoFactor/ matters: an account that has 2FA enabled is rejected further down, but a
+            // verification that is already in flight must never be upgraded into a full session by
+            // this middleware.
+            var path = context.Request.Path.Value ?? string.Empty;
+            if (path.StartsWith("/auth/", StringComparison.OrdinalIgnoreCase)
+                || path.StartsWith("/twofactor/", StringComparison.OrdinalIgnoreCase))
+            {
+                await _next(context);
+                return;
+            }
+
+            if (ConsumeOneShotSkip(context, options))
+            {
+                await _next(context);
+                return;
+            }
+
+            if (!IsSharedSecretValid(context, options))
+            {
+                _logger.LogWarning(
+                    "Gateway request rejected: header '{Header}' missing or does not match the configured secret.",
+                    options.SharedSecretHeader);
+                await WriteTextAsync(context, StatusCodes.Status401Unauthorized, "invalid gateway credentials");
+                return;
+            }
+
+            if (!TryReadIdentity(context, options, out var uid, out var username))
+            {
+                // No identity on this request: internal health probes, direct socket debugging,
+                // or a future port-mode deployment. Fall through to the native flow.
+                await _next(context);
+                return;
+            }
+
+            // Fail-closed, but narrowly: only requests that would actually be authenticated from
+            // headers are refused. Computing this AFTER the identity read is deliberate — a
+            // request without headers keeps falling through to the native login page, which is the
+            // recovery path when the socket permissions are wrong. Refusing everything would turn a
+            // fixable permission problem into "the whole application is down".
+            // The gate is closed until the socket has been *proven* owner-only, not merely until an
+            // attempt has failed. Without the IsHardened half there is a cold-start hole: for the
+            // first moments after boot the background check has not run yet, so a socket created
+            // without a restrictive umask (e.g. someone overriding the image ENTRYPOINT) would be
+            // trusted for up to AppearanceGrace (30s). First chmod lands in the first loop
+            // iteration, so this only affects the first few milliseconds.
+            if (!socketSecurityState.IsHardened || socketSecurityState.HardeningFailed)
+            {
+                _logger.LogError(
+                    "Refusing gateway header authentication: unix socket '{SocketPath}' is not (yet) " +
+                    "restricted to 0600 (hardened={Hardened}, failed={Failed}). " +
+                    "Password sign-in via /Auth/Login still works.",
+                    socketSecurityState.SocketPath,
+                    socketSecurityState.IsHardened,
+                    socketSecurityState.HardeningFailed);
+                await WriteTextAsync(
+                    context,
+                    StatusCodes.Status503ServiceUnavailable,
+                    localizer["GatewaySocketNotHardened"].Value);
+                return;
+            }
+
+            var subject = options.SubjectPrefix + uid;
+
+            // A presented-but-unreadable auth cookie.
+            //
+            // Symptom on a real fpk install: after linking, reopening the app ends in
+            // ERR_TOO_MANY_REDIRECTS while only one "Gateway sign-in" is logged. Cause: the browser
+            // still holds a cookie with the same name issued by an earlier image (or the
+            // DataProtection key directory was not persisted), so it cannot be decrypted. The
+            // principal stays anonymous, we would sign in again and emit a fresh Set-Cookie on
+            // every single request while the stale cookie keeps shadowing it — a redirect storm
+            // that never converges.
+            //
+            // Do not fight it: drop the cookie this once and let the native flow continue. The next
+            // request arrives without it and the normal sign-in path runs.
+            var authCookieName = authenticationOptions.Value.CookieName;
+            if (!string.IsNullOrEmpty(context.Request.Cookies[authCookieName])
+                && context.User?.Identity?.IsAuthenticated != true)
+            {
+                _logger.LogWarning(
+                    "Auth cookie '{Cookie}' was presented but the session could not be decrypted " +
+                    "(stale DataProtection keys or a cookie left by a previous installation). " +
+                    "Clearing it instead of re-issuing a session on every request.",
+                    authCookieName);
+
+                // Delete both scopes: "/" is what older builds emitted, the path base is what this
+                // build emits. Deleting only one would leave the shadowing cookie in place.
+                var pathBase = context.Request.PathBase.HasValue ? context.Request.PathBase.Value! : "/";
+                context.Response.Cookies.Delete(authCookieName, new CookieOptions { Path = pathBase });
+                context.Response.Cookies.Delete(authCookieName, new CookieOptions { Path = "/" });
+
+                await _next(context);
+                return;
+            }
+
+            // Resolved before the session questions below, so the decision can take the link into
+            // account without a second query.
+            var boundUser = await userService.GetUserByGatewaySubjectAsync(subject);
+
+            if (context.User?.Identity?.IsAuthenticated == true)
+            {
+                var currentSubject = context.User.FindFirst(SubjectClaimType)?.Value;
+
+                // Same gateway identity: nothing to do (no DB round-trip on this hot path).
+                if (string.Equals(currentSubject, subject, StringComparison.Ordinal))
+                {
+                    await _next(context);
+                    return;
+                }
+
+                if (string.IsNullOrEmpty(currentSubject))
+                {
+                    // A password session (no gateway stamp). The identity headers are authoritative
+                    // whenever they are present, so the ONLY case that keeps an existing session is a
+                    // request that carries no identity at all (handled earlier, before this block).
+                    //
+                    // There is deliberately NO exemption for the bootstrap administrator: an exemption
+                    // is indistinguishable from the leak it would preserve — whoever sits down at that
+                    // browser next would inherit the administrator's session. The break-glass channel
+                    // does not need one: it exists for "the gateway is broken", and then there are no
+                    // headers to conflict with, so the session survives untouched.
+                    //
+                    // Outcomes, in order:
+                    //   1. subject linked     -> sign out, re-issue as the gateway identity
+                    //   2. unlinked + consent answered -> sign out, go to the LOGIN page
+                    //      (a consent decision answers "may you use my fnOS identity", never "may you
+                    //       inherit this session")
+                    //   3. unlinked + no consent       -> sign out, go to the CONSENT page
+                    var consentCookie = context.Request.Cookies[ConsentCookieName];
+                    var consentRemembered = consentCookie == ConsentAllowedValue
+                                            || consentCookie == ConsentDeclinedValue;
+
+                    // Whose session is this? A password session records the fnOS uid that was on the
+                    // request when it was created ("luid"). If that matches the uid arriving now, the
+                    // same person is still sitting at this browser and the session may stand (this is
+                    // what keeps the break-glass administrator usable on an appliance whose gateway
+                    // always injects headers). If it differs — or is absent — somebody else is here,
+                    // and the session must not be inherited.
+                    var loginUid = context.User.FindFirst(
+                        MailArchiver.Auth.Services.CookieAuthenticationService.LoginUidClaimType)?.Value;
+                    var samePersonAsAtLogin = !string.IsNullOrEmpty(loginUid)
+                                              && string.Equals(loginUid, uid, StringComparison.Ordinal);
+
+                    if (boundUser != null)
+                    {
+                        _logger.LogInformation(
+                            "Gateway identity changed (password session -> fnOS identity {Subject}); re-issuing the session.",
+                            subject);
+                    }
+                    else if (consentRemembered && samePersonAsAtLogin)
+                    {
+                        // SAME PERSON, STILL HERE -> keep the session.
+                        //
+                        // "luid" exists to answer exactly one question: is the fnOS user arriving now
+                        // the same one who created this password session? It is NOT a permission
+                        // check and must never be used as one.
+                        //
+                        //  * luid == subject  -> the same fnOS account is still at this browser, so the
+                        //    session belongs to the person holding the keyboard. Keeping it is what
+                        //    makes a password login usable at all: the gateway injects an identity
+                        //    header on EVERY request, so without this branch every password session
+                        //    would be signed out on its very next request — including the only
+                        //    administrator a fresh installation has, which would make the appliance
+                        //    permanently unusable (login -> kicked -> login).
+                        //  * luid absent      -> we cannot prove continuity, so treat it as a different
+                        //    person and drop it (conservative: the caller falls through to the consent
+                        //    branch below).
+                        //  * luid != subject  -> someone else is at this browser; drop it.
+                        //
+                        // This is safe precisely because luid is stamped into the encrypted session
+                        // ticket at password-login time: it cannot be forged or set by the caller.
+                        _logger.LogDebug(
+                            "Password session kept: fnOS identity {Subject} matches the identity recorded at " +
+                            "sign-in and this browser already answered the consent question.", subject);
+
+                        await _next(context);
+                        return;
+                    }
+                    else
+                    {
+                        _logger.LogInformation(
+                            "Password session dropped (identity-mixing-prevented): fnOS identity {Subject} is " +
+                            "not linked and no consent decision is remembered for this browser. " +
+                            "Sending the user to the consent step.",
+                            subject);
+
+                        await context.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
+                        context.User = new ClaimsPrincipal(new ClaimsIdentity());
+
+                        var consentReturnUrl = context.Request.Path + context.Request.QueryString;
+                        context.Response.Redirect(
+                            $"{context.Request.PathBase}/Auth/Consent?returnUrl={Uri.EscapeDataString(consentReturnUrl)}");
+                        return;
+                    }
+                }
+                else
+                {
+                    // A different fnOS user is now driving this browser (fnOS session switched).
+                    _logger.LogInformation(
+                        "Gateway identity changed from {Old} to {New}; re-issuing the session.",
+                        currentSubject, subject);
+                }
+
+                await context.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
+                context.User = new ClaimsPrincipal(new ClaimsIdentity());
+            }
+
+            var user = boundUser;
+            if (user == null)
+            {
+                // Nothing linked yet: ask for consent before anything else, mirroring the platform's
+                // own authorisation prompt. Deliberately limited to plain page GETs — an API/MCP
+                // caller must keep getting its 401 shape, and a POST must not be turned into a
+                // redirect that silently drops the body.
+                //
+                // Declining is remembered in a cookie; when it is present we fall through to the
+                // native login page instead of prompting again.
+                var consentCookie = context.Request.Cookies[ConsentCookieName];
+                var decisionRemembered = consentCookie == ConsentDeclinedValue || consentCookie == ConsentAllowedValue;
+                var isPageGet = HttpMethods.IsGet(context.Request.Method)
+                                && !path.StartsWith("/api/", StringComparison.OrdinalIgnoreCase)
+                                && !path.StartsWith("/mcp", StringComparison.OrdinalIgnoreCase);
+
+                if (isPageGet && !decisionRemembered)
+                {
+                    var returnUrl = context.Request.Path + context.Request.QueryString;
+                    _logger.LogDebug(
+                        "Gateway subject {Subject} is not linked yet; offering the consent step.", subject);
+                    context.Response.Redirect(
+                        $"{context.Request.PathBase}/Auth/Consent?returnUrl={Uri.EscapeDataString(returnUrl)}");
+                    return;
+                }
+
+                // Declined earlier, or not a page GET: fall through so the login page can offer the
+                // one-time link.
+                _logger.LogDebug("No local account linked to gateway subject {Subject}; falling back to native login.", subject);
+                await _next(context);
+                return;
+            }
+
+            // Fail-closed: never mutate these two flags, just refuse.
+            if (!user.IsActive || user.RequiresApproval)
+            {
+                var reason = !user.IsActive ? "disabled" : "pending approval";
+                _logger.LogWarning(
+                    "Gateway sign-in refused for account {Username} (id {UserId}): account is {Reason}.",
+                    user.Username, user.Id, reason);
+
+                await accessLogService.LogAccessAsync(
+                    user.Username,
+                    AccessLogType.Login,
+                    searchParameters: $"fnOS uid={uid} denied: account {reason}");
+
+                await WriteTextAsync(
+                    context,
+                    StatusCodes.Status403Forbidden,
+                    !user.IsActive
+                        ? localizer["GatewayAccountDisabled"].Value
+                        : localizer["GatewayAccountPendingApproval"].Value);
+                return;
+            }
+
+            // Fail-closed: an account that protects itself with a second factor must not be signed
+            // in by a path that never asks for it. This can happen after linking: the link is only
+            // created while 2FA is OFF, but the user may enable it afterwards. Silently ignoring it
+            // would make 2FA decorative while the UI still claims it is enabled.
+            if (user.IsTwoFactorEnabled)
+            {
+                _logger.LogWarning(
+                    "Gateway sign-in refused for account {Username} (id {UserId}): two-factor authentication is enabled.",
+                    user.Username, user.Id);
+
+                await accessLogService.LogAccessAsync(
+                    user.Username,
+                    AccessLogType.Login,
+                    searchParameters: $"fnOS uid={uid} denied: account requires two-factor authentication");
+
+                await WriteTextAsync(
+                    context,
+                    StatusCodes.Status403Forbidden,
+                    localizer["GatewayAccountRequiresTwoFactor"].Value);
+                return;
+            }
+
+            var principal = authService.BuildPrincipal(user, subject);
+            var authProperties = new AuthenticationProperties
+            {
+                IsPersistent = false,
+                IssuedUtc = DateTimeOffset.UtcNow,
+                ExpiresUtc = DateTimeOffset.UtcNow.AddMinutes(authService.GetSessionTimeoutMinutes())
+            };
+
+            await context.SignInAsync(
+                CookieAuthenticationDefaults.AuthenticationScheme, principal, authProperties);
+
+            // CRITICAL: SignInAsync only writes the response cookie. Without this assignment the
+            // *current* request is still anonymous and the downstream AuthenticationMiddleware
+            // would 302 it back to the login page (the classic "signed in but bounced" symptom).
+            context.User = principal;
+
+            await accessLogService.LogAccessAsync(
+                user.Username,
+                AccessLogType.Login,
+                searchParameters: $"fnOS uid={uid} via gateway");
+
+            await userService.TouchLastLoginAsync(user.Id);
+
+            _logger.LogInformation(
+                "Gateway sign-in: fnOS uid={Uid} ({UserName}) -> local account {Username} (id {UserId}).",
+                uid, username, user.Username, user.Id);
+
+            await _next(context);
+        }
+
+        /// <summary>
+        /// Reads the injected identity. Returns false when the request carries no usable uid.
+        ///
+        /// The uid is the only identity key: it is validated as pure ASCII digits so that it can
+        /// be embedded in the stored subject without escaping concerns. The user name is
+        /// best-effort and display-only.
+        /// </summary>
+        public static bool TryReadIdentity(HttpContext context, GatewayOptions options, out string uid, out string username)
+        {
+            uid = string.Empty;
+            username = string.Empty;
+
+            var rawUid = context.Request.Headers[options.UserIdHeader].ToString();
+            if (string.IsNullOrWhiteSpace(rawUid))
+            {
+                return false;
+            }
+
+            rawUid = rawUid.Trim();
+            if (rawUid.Length == 0 || rawUid.Length > 20 || !rawUid.All(char.IsAsciiDigit))
+            {
+                return false;
+            }
+
+            uid = rawUid;
+
+            var rawName = context.Request.Headers[options.UsernameHeader].ToString();
+            username = string.IsNullOrWhiteSpace(rawName)
+                ? string.Empty
+                : RepairUtf8HeaderText(rawName.Trim());
+
+            return true;
+        }
+
+        /// <summary>
+        /// Normalises the injected user name for display.
+        ///
+        /// HTTP header values are bytes; depending on the server they may arrive already decoded
+        /// as Unicode, or as UTF-8 bytes that were read as Latin-1 (mojibake). Two cases:
+        ///  * any character above U+00FF  -> already real Unicode, keep it untouched;
+        ///  * only characters up to U+00FF -> re-interpret the Latin-1 bytes as UTF-8, which is
+        ///    what fnOS actually sends. Invalid UTF-8 keeps the original string.
+        ///
+        /// Getting this wrong is not fatal (the uid is the identity key), but silently turning a
+        /// correct name into "????" would be. Hence the strict range check before converting.
+        /// </summary>
+        internal static string RepairUtf8HeaderText(string value)
+        {
+            if (value.Length == 0)
+            {
+                return value;
+            }
+
+            // Already real Unicode (e.g. the server decoded the header correctly), or plain ASCII.
+            if (value.Any(c => c > 0xFF) || value.All(c => c < 0x80))
+            {
+                return value;
+            }
+
+            try
+            {
+                // Every character is <= U+00FF here, so this is a lossless byte round-trip.
+                var bytes = Encoding.Latin1.GetBytes(value);
+                return new UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true)
+                    .GetString(bytes);
+            }
+            catch
+            {
+                return value;
+            }
+        }
+
+        /// <summary>
+        /// Consumes a ONE-SHOT skip for the request that directly follows a sign-out.
+        ///
+        /// Why one-shot: the previous design kept the skip armed for a fixed window (60s). Inside
+        /// that window the gateway identity was ignored — and because a linked account can no longer
+        /// use a password (UserService rejects any account whose OAuthRemoteUserId is set), neither
+        /// path worked. Users were locked out until the window expired or the container restarted.
+        ///
+        /// One request is all that is needed: the skip exists solely to stop the redirect that
+        /// follows sign-out from immediately signing the user back in. Removing the marker here
+        /// means every subsequent request falls back to normal auto sign-in, so a dead interval
+        /// cannot exist.
+        /// </summary>
+        private static bool ConsumeOneShotSkip(HttpContext context, GatewayOptions options)
+        {
+            var raw = context.Session.GetString(LogoutSuppressedAtKey);
+            if (string.IsNullOrEmpty(raw) || !long.TryParse(raw, out var unixSeconds))
+            {
+                return false;
+            }
+
+            // Consumed on first use, whatever the outcome.
+            context.Session.Remove(LogoutSuppressedAtKey);
+
+            var suppressedAt = DateTimeOffset.FromUnixTimeSeconds(unixSeconds);
+            return DateTimeOffset.UtcNow - suppressedAt < TimeSpan.FromSeconds(Math.Max(1, options.LogoutSuppressionSeconds));
+        }
+
+        private static bool IsSharedSecretValid(HttpContext context, GatewayOptions options)
+        {
+            if (string.IsNullOrWhiteSpace(options.SharedSecret))
+            {
+                return true;
+            }
+
+            var presented = context.Request.Headers[options.SharedSecretHeader].ToString();
+            if (string.IsNullOrEmpty(presented))
+            {
+                return false;
+            }
+
+            var expected = Encoding.UTF8.GetBytes(options.SharedSecret!);
+            var actual = Encoding.UTF8.GetBytes(presented);
+            return System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(expected, actual);
+        }
+
+        private static async Task WriteTextAsync(HttpContext context, int statusCode, string message)
+        {
+            if (context.Response.HasStarted)
+            {
+                return;
+            }
+
+            context.Response.Clear();
+            context.Response.StatusCode = statusCode;
+            context.Response.ContentType = "text/plain; charset=utf-8";
+            await context.Response.WriteAsync(message);
+        }
+    }
+}
diff --git a/Auth/Options/GatewayOptions.cs b/Auth/Options/GatewayOptions.cs
new file mode 100644
index 0000000..12f7a63
--- /dev/null
+++ b/Auth/Options/GatewayOptions.cs
@@ -0,0 +1,83 @@
+namespace MailArchiver.Auth.Options
+{
+    /// <summary>
+    /// Configuration for the fnOS ("飞牛") gateway identity bridge.
+    ///
+    /// The fnOS unified gateway authenticates the NAS session itself and then forwards the
+    /// request to this application over a unix domain socket, injecting the caller's identity
+    /// as HTTP headers. Because the application listens on a 0600 unix socket and publishes no
+    /// TCP port, "request arrived on the socket" is the trust boundary; these options only
+    /// describe how to read the injected identity.
+    ///
+    /// DELIBERATELY ABSENT: there is no admin/role option here. The gateway also sends
+    /// <c>X-Trim-Isadmin</c>, but this application does NOT read it and does NOT map it onto
+    /// <see cref="Models.User.IsAdmin"/>. Authorisation is decided solely by the local
+    /// Mail Archiver account. Do not add role mapping here without a separate design review.
+    /// </summary>
+    public class GatewayOptions
+    {
+        public const string Gateway = "Gateway";
+
+        /// <summary>Master switch. When false the middleware is a no-op and behaviour is
+        /// byte-for-byte identical to upstream.</summary>
+        public bool Enabled { get; set; } = false;
+
+        /// <summary>
+        /// Optional shared secret. Empty (default) means "skip the check" — correct for the
+        /// single-container fpk where the unix socket permission is the only trust boundary.
+        /// Set this only when a sidecar/proxy sits in front and can inject the header.
+        /// </summary>
+        public string? SharedSecret { get; set; }
+
+        /// <summary>Header carrying <see cref="SharedSecret"/>. Ignored when the secret is empty.</summary>
+        public string SharedSecretHeader { get; set; } = "X-Gateway-Secret";
+
+        /// <summary>Header carrying the fnOS OS uid. This is the ONLY identity key.</summary>
+        public string UserIdHeader { get; set; } = "X-Trim-Userid";
+
+        /// <summary>
+        /// Header carrying the fnOS user name. DISPLAY ONLY — it is a snapshot taken at fnOS
+        /// login time (it goes stale after a rename) and may contain non-ASCII characters, so it
+        /// must never be used as a lookup key.
+        /// </summary>
+        public string UsernameHeader { get; set; } = "X-Trim-Username";
+
+        /// <summary>
+        /// Where to send the browser after sign-out. Empty means "back to the application root",
+        /// which lands on the login page with the auto-login suppressed for
+        /// <see cref="LogoutSuppressionSeconds"/>.
+        /// </summary>
+        public string LogoutRedirectUrl { get; set; } = "";
+
+        /// <summary>
+        /// Upper bound for the ONE-SHOT skip that follows an explicit sign-out (default 15s).
+        ///
+        /// This is only a safety net against a stale marker, not a suppression window: the marker is
+        /// consumed by the first request that sees it, so auto sign-in resumes immediately
+        /// afterwards. Keeping this short is deliberate — a long window would recreate the
+        /// "neither password nor fnOS identity works" deadlock this replaced.
+        /// </summary>
+        public int LogoutSuppressionSeconds { get; set; } = 15;
+
+        /// <summary>
+        /// Prefix stored in <see cref="Models.User.OAuthRemoteUserId"/> so that a gateway subject
+        /// can never collide with an OIDC subject (which is stored bare).
+        /// </summary>
+        public string SubjectPrefix { get; set; } = "fnos:";
+
+        /// <summary>
+        /// Whether the bootstrap administrator (the account named by <c>Authentication:Username</c>)
+        /// may be linked to an fnOS identity.
+        ///
+        /// Default FALSE on purpose: linking an account permanently disables its password sign-in
+        /// (<see cref="Services.UserService.AuthenticateUserAsync"/> rejects any account whose
+        /// OAuthRemoteUserId is set). If the bootstrap administrator were linked and the gateway
+        /// path then broke — socket permissions, a PathBase change, a gateway upgrade — there would
+        /// be no way back into the application from the UI. Keeping one password-capable
+        /// administrator is the break-glass channel; see the recovery procedure in the delivery
+        /// notes. Set to true only if that administrator will also keep a second, unlinked admin
+        /// account around.
+        /// </summary>
+        public bool AllowBindBootstrapAdmin { get; set; } = false;
+    }
+}
