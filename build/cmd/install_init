#!/bin/bash
# 安装前：只读校验，任何一项硬失败都 exit 1（错误写 TRIM_TEMP_LOGFILE 让应用中心显示）
set -u

APP_NAME=mail-archiver-fnos
VAR_DIR="${TRIM_PKGVAR:-}"
CFG_DIR="${TRIM_PKGETC:-}"
LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR:-/tmp}/lifecycle.log}"

say() { echo "[${APP_NAME}] $*"; }
fail() { echo "[${APP_NAME}] ERROR: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] ERROR: $*" >&2; exit 1; }
warn() { echo "[${APP_NAME}] WARN: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] WARN: $*" >&2; }

say "install_init begin"

# ---------------------------------------------------------------- 残留自愈（"存在安装历史"）
# ★ 判定语义（用户实测指出并确认）：**空目录 = 干净**，只有"目录里有内容"才算残留。
#   平台卸载后常留下**空壳目录**（如 ${TRIM_APPTEMP}/<app>、/var/apps/<app>），
#   旧实现用 `[ -d ]` 判存在 → 把空壳当残留，界面就报"未删干净"，用户只能手删。
#   新实现一律用"内容是否为空"判断（`ls -A` / `find -mindepth 1 -print -quit`）。
dir_has_content() {   # 0 = 有内容；1 = 空目录或不存在；符号链接单独算"有内容"
    local p="$1"
    [ -L "${p}" ] && return 0            # 链接本身即残留（目标不看）
    [ -d "${p}" ] || return 1            # 不存在或非目录 → 不算残留
    [ -n "$(ls -A "${p}" 2>/dev/null)" ] || return 1   # 空目录 → 干净
    return 0
}

clean_app_residue() {
    local app="$1" cleaned=0 blocked="" emptied=""
    local tmp="${TRIM_APPTEMP:-}" ac="${TRIM_APPCENTER:-}"

    # ① 平台临时目录：有内容才清；空壳只记录"已视为干净"
    if [ -n "${tmp}" ] && [ -d "${tmp}/${app}" ]; then
        if dir_has_content "${tmp}/${app}"; then
            say "检测到平台临时目录残留：${tmp}/${app}（内容 $(ls -A "${tmp}/${app}" 2>/dev/null | tr '\n' ' ')），正在清理…"
            if find "${tmp}/${app}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; then
                say "已清理 ${tmp}/${app} 下的内容（目录本身保留）"
                cleaned=1
            else
                blocked="${blocked}\n  ${tmp}/${app}（清理失败，需要 root 删除）"
            fi
        else
            say "平台临时目录为空壳（无任何文件），**视为干净**：${tmp}/${app}"
            emptied="${emptied}\n  ${tmp}/${app}"
        fi
    fi

    # ② 陈旧运行时目录 @appcenter/<app>：同样按内容判断；有运行中容器则跳过
    if [ -n "${ac}" ] && [ -d "${ac}/${app}" ]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -qE "^${app}(-db)?$"; then
            say "提示：${ac}/${app} 有内容但本应用容器仍在运行，跳过清理（请先在应用中心停止应用）。"
        elif dir_has_content "${ac}/${app}"; then
            say "检测到陈旧运行时残留：${ac}/${app}（无运行中容器），正在清理…"
            if find "${ac}/${app}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; then
                say "已清理 ${ac}/${app} 下的内容（目录本身保留，平台会重建）"
                cleaned=1
            else
                blocked="${blocked}\n  ${ac}/${app}（清理失败，需要 root）"
            fi
        else
            say "运行时目录为空壳（无任何文件），**视为干净**：${ac}/${app}"
            emptied="${emptied}\n  ${ac}/${app}"
        fi
    fi

    # ③ 数据根：pgdata **非空** 才算"已有数据"（空 pgdata = 全新安装）
    local pg="${TRIM_PKGVAR:-}/data/pgdata"
    if [ -d "${pg}" ] && [ -n "$(ls -A "${pg}" 2>/dev/null)" ]; then
        say "提示：${pg} 已有数据（非空），**不会被删除**；安装将沿用这份数据。"
    fi

    # ④ 其它本应用路径：**按内容**报告，空壳一律视为干净
    local d extra=""
    for d in "${TRIM_PKGETC:-}" "${TRIM_APPMETA:-}" "${TRIM_APPHOME:-}"; do
        [ -n "${d}" ] || continue
        [ -e "${d}" ] || continue
        if dir_has_content "${d}"; then extra="${extra}\n  ${d}"; else emptied="${emptied}\n  ${d}"; fi
    done
    if [ -n "${extra}" ]; then
        say "以下本应用路径**含有内容**（安装会复用它们；若平台仍报「存在安装历史」而无法继续，请删除这些路径后重试，或运行 scripts/clean-app-residue.sh）："
        printf '%b\n' "${extra}" | sed '/^$/d;s/^/    /'
    fi
    if [ -n "${emptied}" ]; then
        say "以下为空壳目录（无文件），**已视为干净、不会拦截安装**，安装时会被清空并复用："
        printf '%b\n' "${emptied}" | sed '/^$/d;s/^/    /'
    fi

    if [ -n "${blocked}" ]; then
        fail "存在无法自动清理的本应用残留（有内容且清理失败），请手工删除后重试：${blocked}"
    fi

    if [ "${cleaned}" = "1" ]; then
        say "残留自愈完成：已清理本应用**有内容**的残留（空壳目录不拦人）。"
    else
        say "残留自愈检查完成：未发现需要清理的残留（空壳目录一律视为干净）。"
    fi
}

clean_app_residue "${APP_NAME}"



# 1) 运行身份：compose 用 ${TRIM_UID}:${TRIM_GID} 指定容器用户，缺了数据目录必然写不进去
[ -n "${TRIM_UID:-}" ] || fail "安装环境未提供 TRIM_UID，无法确定容器运行用户，已中止。"
[ -n "${TRIM_GID:-}" ] || fail "安装环境未提供 TRIM_GID，无法确定容器运行用户，已中止。"
[ -n "${VAR_DIR}" ]    || fail "安装环境未提供 TRIM_PKGVAR，已中止。"
[ -n "${CFG_DIR}" ]    || fail "安装环境未提供 TRIM_PKGETC，已中止。"

# 2) 架构：首版只发 x86
arch="$(uname -m)"
case "${arch}" in
    x86_64 | amd64) ;;
    *) fail "本包仅支持 x86_64 设备（当前 ${arch}）。" ;;
esac

# 3) Docker / Compose（降级为告警：安装期 daemon 可能还没起）
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    say "docker ok: $(docker --version 2>/dev/null | head -1)"
else
    warn "Docker 不可用（未安装或 daemon 未运行），安装继续但应用无法启动。排查：systemctl status docker；ls -l /var/run/docker.sock"
fi
if command -v docker >/dev/null 2>&1 && ! docker compose version >/dev/null 2>&1; then
    warn "docker compose v2 不可用，应用由应用中心托管启动，缺少它会导致启动失败。"
fi

# 3b) 镜像预载（关键：必须发生在平台 init-docker 之前）
# 平台的安装流程是 install_init → 解包 → init-docker( compose up ) → install_callback。
# 本地构建的私镜像（mail-archiver-fnos:zh-*）不在任何公共 registry 上，
# 若等到 init-docker 才准备，compose 会尝试 pull 并失败（实测：event=APP_INSTALL_FAILED_INIT_DOCKER_EXCEPTION）。
# 因此在这里从"包解压目录"里把 images/*.tar 先 load 进本地 docker。
APP_NAME=mail-archiver-fnos
IMAGE_REF_DEFAULT="mail-archiver-fnos:zh-39f59d2"

preload_image() {
    tarball=""
    for d in "${TRIM_TEMP_TPKFILE:-}" "${TRIM_PKGINST_TEMP_DIR:-}" \
             "/vol1/appcenter-downloads/${APP_NAME}-${TRIM_APPVER:-}-tpk"; do
        [ -n "${d}" ] && [ -d "${d}" ] || continue
        say "探测包目录：${d}"
        found="$(tar tzf "${d}/app.tgz" 2>/dev/null | grep -m1 '^images/.*\.tar$' || true)"
        if [ -n "${found}" ]; then
            tarball="${d}/app.tgz:${found}"
            break
        fi
    done
    [ -n "${tarball}" ] || { say "包内未发现镜像 tar（走在线拉取）"; return 0; }

    pkg="${tarball%%:*}"; mem="${tarball#*:}"
    say "包内镜像：${mem}（来自 ${pkg}）"
    tmpd="$(mktemp -d 2>/dev/null || echo /tmp/mapreload)"
    mkdir -p "${tmpd}" && tar xzf "${pkg}" -C "${tmpd}" "${mem}" 2>/dev/null || true
    if [ -f "${tmpd}/${mem}" ]; then
        docker load -i "${tmpd}/${mem}" >/dev/null 2>&1 \
            && say "镜像预载完成：$(basename "${mem}")" \
            || warn "docker load 失败（${mem}），稍后由 install_callback 重试/在线拉取"
        rm -rf "${tmpd}"
    else
        warn "解出镜像 tar 失败（${mem}）"
        rm -rf "${tmpd}"
    fi
}

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    if docker image inspect "${IMAGE_REF_DEFAULT}" >/dev/null 2>&1; then
        say "镜像已在本机：${IMAGE_REF_DEFAULT}（跳过预载）"
    else
        preload_image || true
    fi
fi

# 4) 内存：3GB 以下给告警（.NET 应用 + PostgreSQL 同机）
mem_kb="$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null)"
if [ -n "${mem_kb}" ] && [ "${mem_kb}" -lt 3145728 ]; then
    warn "物理内存不足 3GB（$(awk -v k="${mem_kb}" 'BEGIN{printf "%.1f", k/1048576}')GB）。本应用为 .NET（无 JVM），与 PostgreSQL 同机运行，建议 ≥4GB；内存不足可通过容器内存限制调节。"
fi

# 5) 空间：镜像解压 + 数据库起步约 1.5GB
space_probe=""
for p in "${TRIM_APPDEST_VOL:-}" "/vol1" "$(dirname "${VAR_DIR}")" "/"; do
    [ -n "${p}" ] && [ -d "${p}" ] && { space_probe="${p}"; break; }
done
avail_kb="$(df -Pk "${space_probe:-/}" 2>/dev/null | awk 'NR==2{print $4}')"
if [ -n "${avail_kb}" ] && [ "${avail_kb}" -lt 2097152 ]; then
    warn "可用空间不足 2GB（${space_probe:-/} 剩 $(awk -v k="${avail_kb}" 'BEGIN{printf "%.1f", k/1048576}')GB），数据库可能起不来。"
fi

# 6) 本应用不发布任何 TCP 端口，故不做端口占用检查（这是设计约束，不是遗漏）
say "本应用不监听任何 TCP 端口，仅通过 ${TRIM_APPDEST:-<app dir>}/app.sock 暴露给 fnOS 统一网关。"

# 7) 数据目录（可选自定义）：只提示，不阻断——真正的判定与回落放在 install_callback
data_pref="${wizard_data_dir:-}"
if [ -n "${data_pref}" ]; then
    if [ -d "${data_pref}" ] && [ -w "${data_pref}" ]; then
        say "自定义数据目录可写：${data_pref}"
    else
        warn "自定义数据目录 ${data_pref} 当前不可写。若它位于存储空间，请先在「应用设置 → 访问权限」里把该目录授权给本应用，否则 install_callback 会回落到应用自有目录。"
    fi
fi

say "install_init ok"
exit 0
