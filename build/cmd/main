#!/bin/bash
# 服务控制：start / stop / status
# status 退出码：0=运行中就绪 / 1=在跑但未就绪（socket 缺失或权限不对） / 3=未运行
set -u

APP_NAME="${APP_NAME:-mail-archiver-fnos}"
APPDEST="${TRIM_APPDEST:-}"   # set -u 下未定义会直接崩，兜底必须先取到空串
VAR_DIR="${TRIM_PKGVAR}"
CFG_DIR="${TRIM_PKGETC}"
LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR:-/tmp}/lifecycle.log}"
# 0.1.44：APPDEST 为空时曾拼成 /docker/docker-compose.yaml → "exit status 1: open /docker/…"（装不上）。
# 这里只加缺省兜底，非空时行为完全不变。
APPDEST="${APPDEST:-/vol1/@appcenter/${APP_NAME}}"
COMPOSE_FILE="${APPDEST:-/vol1/@appcenter/${APP_NAME}}/docker/docker-compose.yaml"
SOCK="${APPDEST}/app.sock"

say() { echo "[${APP_NAME}] $*"; }
fail() { echo "[${APP_NAME}] ERROR: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] ERROR: $*" >&2; exit 1; }
warn() { echo "[${APP_NAME}] WARN: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] WARN: $*" >&2; }
trace() { { mkdir -p "${VAR_DIR}" && echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"${VAR_DIR}/lifecycle.log"; } 2>/dev/null || true; }

# socket 权限看护：容器自己会 chmod，这里再兜一层（真实应用换成 Kestrel 时尤其需要）
. "$(dirname "$0")/lib_runtime_dirs.sh" 2>/dev/null

watch_socket() {
    (
        i=0
        while [ "$i" -lt 60 ]; do
            i=$((i + 1))
            if [ -S "${SOCK}" ]; then
                mode="$(stat -c '%a' "${SOCK}" 2>/dev/null || echo '')"
                if [ "${mode}" != "600" ]; then
                    chmod 600 "${SOCK}" 2>/dev/null && echo "$(date '+%F %T') chmod 600 ${SOCK} (was ${mode})" >>"${VAR_DIR}/socket_perm.log"
                fi
                return 0
            fi
            sleep 1
        done
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

# 0.1.36：查看数据库口令明文（读 600 文件；无文件则提示）
if [ "${1:-}" = "--show-db-password" ]; then
    # 0.1.38：直接读 @appconf/pg_password（600，天然受控），不再依赖 /vol1/1000 明文文件
    _pf="${TRIM_PKGETC:-/vol1/@appconf/mail-archiver-fnos}/pg_password"
    if command -v show_db_password >/dev/null 2>&1; then
        show_db_password "${_pf}" && exit 0 || { echo "[${APP_NAME}] 口令不合规或缺失（${_pf}）" >&2; exit 1; }
    else
        echo "[${APP_NAME}] 缺少 cmd/lib/pg-password-guard.sh" >&2; exit 1
    fi
fi

# 0.1.34：受控查看数据库口令指纹（只 len/sha8，绝不回显明文）
if [ "${1:-}" = "--show-db-fingerprint" ]; then
    for _l in pg-password-guard.sh; do
        [ -r "$(dirname "$0")/lib/${_l}" ] && . "$(dirname "$0")/lib/${_l}" 2>/dev/null || true
    done
    _pwf="${TRIM_PKGETC:-/vol1/@appconf/mail-archiver-fnos}/pg_password"
    if ! command -v show_db_fingerprint >/dev/null 2>&1; then
        echo "[${APP_NAME}] 缺少 cmd/lib/pg-password-guard.sh" >&2; exit 1
    fi
    if show_db_fingerprint "${_pwf}"; then
        echo "[${APP_NAME}] 数据库口令指纹如上（只显示指纹与长度，不回显明文）"
        exit 0
    else
        echo "[${APP_NAME}] 指纹无意义：口令不合规/缺失（${_pwf}）" >&2
        exit 1
    fi
fi

# 0.1.35（M3）：socket 假告警降级
for _l in mustfix-0134.sh; do [ -r "$(dirname "$0")/lib/${_l}" ] && . "$(dirname "$0")/lib/${_l}" 2>/dev/null || true; done

case "${1:-}" in
    start)
        trace "main start"
        ensure_payload_docker_dir

# 0.1.25（官方 data-share）：若平台注入了共享目录，且当前数据根未指向它，只提示、不在运行期迁移
_share="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -n "${_share}" ] && [ -d "${_share}" ] && [ -L "${TRIM_PKGVAR}/data" ]; then
    _cur="$(readlink -f "${TRIM_PKGVAR}/data" 2>/dev/null)"
    [ "${_cur}" = "$(readlink -f "${_share}" 2>/dev/null)" ] \
        || say "提示：系统共享目录 ${_share} 未被使用（当前数据根 ${_cur}）。如需切换请卸载（保留数据）后重装。" 
fi
        [ -f "${COMPOSE_FILE}" ] || fail "compose 文件缺失：${COMPOSE_FILE}"
        # 容器由应用中心托管启动；这里做一次幂等 up 保证读到当前 app.env（冷启动占位配置不会被沿用）
        if docker compose version >/dev/null 2>&1; then
            docker compose -p "${APP_NAME}" -f "${COMPOSE_FILE}" up -d >/dev/null 2>&1 || warn "compose up 未生效（应用中心可能已在启动）"
        fi
        watch_socket
        say "start ok（socket 权限看护已挂起 60s）"
        exit 0
        ;;
    stop)
        trace "main stop"
        exit 0
        ;;
    status)
        running="$(docker inspect -f '{{.State.Running}}' "${APP_NAME}" 2>/dev/null)" || exit 3
        [ "${running}" = "true" ] || exit 3
        if [ ! -S "${SOCK}" ]; then
            # 0.1.35（M3）：轮询 30s，未就绪也只 note，不以失败口吻收尾
            wait_for_app_socket "${SOCK}" 30
            [ -S "${SOCK}" ] || exit 1
        fi
        mode="$(stat -c '%a' "${SOCK}" 2>/dev/null || echo '')"
        if [ "${mode}" != "600" ]; then
            warn "socket 权限为 ${mode}，正在收紧为 600"
            chmod 600 "${SOCK}" 2>/dev/null || true
        fi
        db_running="$(docker inspect -f '{{.State.Running}}' "${APP_NAME}-db" 2>/dev/null || echo false)"
        [ "${db_running}" = "true" ] || { echo "[${APP_NAME}] status: 数据库容器未运行" >&2; exit 1; }
        exit 0
        ;;
    *)
        fail "未知子命令：${1:-<空>}（支持 start|stop|status）"
        ;;
esac
