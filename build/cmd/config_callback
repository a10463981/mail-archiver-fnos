#!/bin/bash
# 设置页保存后：改密码 / 换数据目录 / 换时区，然后重建容器让新环境生效。
set -u

APP_NAME="${APP_NAME:-mail-archiver-fnos}"
CFG_DIR="${TRIM_PKGETC}"
VAR_DIR="${TRIM_PKGVAR}"
APPDEST="${TRIM_APPDEST:-}"   # set -u 下未定义会直接崩，兜底必须先取到空串
LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR:-/tmp}/lifecycle.log}"
APP_ENV="${CFG_DIR}/app.env"
SETTINGS="${CFG_DIR}/settings.env"
# 0.1.44：APPDEST 为空时曾拼成 /docker/docker-compose.yaml → "exit status 1: open /docker/…"（装不上）。
# 这里只加缺省兜底，非空时行为完全不变。
APPDEST="${APPDEST:-/vol1/@appcenter/${APP_NAME}}"
COMPOSE_FILE="${APPDEST:-/vol1/@appcenter/${APP_NAME}}/docker/docker-compose.yaml"
DATA_ROOT="${VAR_DIR}/data"

say() { echo "[${APP_NAME}] $*"; }
fail() { echo "[${APP_NAME}] ERROR: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] ERROR: $*" >&2; exit 1; }
warn() { echo "[${APP_NAME}] WARN: $*" >>"${LOG_FILE}" 2>/dev/null || true; echo "[${APP_NAME}] WARN: $*" >&2; }
trace() { { mkdir -p "${VAR_DIR}" && echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"${VAR_DIR}/lifecycle.log"; } 2>/dev/null || true; }
compose() { docker compose -p "${APP_NAME}" -f "${COMPOSE_FILE}" "$@"; }

trace "config_callback begin"
[ -f "${APP_ENV}" ] || fail "缺少 ${APP_ENV}，请先重装应用（或运行一次 cmd/install_callback）。"

# 0.1.37：运行设置动作分派组件（校验→备份→执行→回滚；明文只进环境变量）
for _l in runtime-settings.sh pg-password-guard.sh; do
    [ -r "$(dirname "$0")/lib/${_l}" ] && . "$(dirname "$0")/lib/${_l}" 2>/dev/null || true
done

# 0.1.38：数据目录改为 tips 说明（非输入框），无需注入字段；路径只在日志里打印一次
say "当前数据目录（只读）：$(readlink -f "${DATA_ROOT}" 2>/dev/null || echo "${DATA_ROOT}")"

# 1) 换数据目录：只改符号链接，不搬数据
data_mode="${wizard_data_mode:-keep}"
data_target="${wizard_data_dir:-}"
# ================= 0.1.22 方案 B：运行期不支持切换数据目录 =================
# 为什么移除：一次运行期切换要同时满足"符号链接改向 + 容器强制重建 + 目标库口令对齐 + 载荷 docker 目录齐全"，
# 且与平台状态机（保存配置时 STOP→自己 START）天然抢跑；历史上所有"起不来/白屏/转圈"都出在这条链路上。
# 换目录的唯一入口改为：应用中心「卸载」→ 选「保留数据」→ 重装时在向导里指定新目录。
if [ "${data_mode}" = "custom" ] || [ "${data_mode}" = "default" ]; then
    say "数据目录运行期不可改（方案 B）：本次**未执行任何迁移**，应用保持原状。"
    say "如需更换数据目录：应用中心「卸载」并选择「保留数据」→ 重新安装时在向导里指定新目录。"
    trace "config_callback: data-dir switch refused (plan B, mode=${data_mode})"
    if [ -n "${data_target}" ]; then
        say "（你填写的目标：${data_target}；未做任何改动）"
    fi
fi

# 2) 【0.1.39 已删除旧路径】原「向导密码」段会"每次保存设置都把 admin 密码重置回
#     安装时向导的口令"（实测 20 次覆盖、用户设置的新密码从未生效）。重置入口统一走下方 2b 的新分派。

# 2b) 0.1.39：新版动作分派（两个动作**各自校验/执行/报告，互不阻塞**；有改动才重启一次）
_dbpw="${cfg_db_password:-}"
_admpw="${cfg_admin_reset_password:-}"
if [ -n "${_dbpw}" ] || [ -n "${_admpw}" ]; then
    if command -v runtime_settings_apply >/dev/null 2>&1; then
        _adm_user="$(grep -m1 '^Authentication__Username=' "${APP_ENV}" 2>/dev/null | cut -d= -f2-)"
        [ -n "${_adm_user}" ] || _adm_user="admin"
        _rs_files="${CFG_DIR}/pg_password
${CFG_DIR}/admin_password
${APP_ENV}
${APPDEST}/docker/pg_password"
        # 0.1.43：第 4 位传**应用账号名**（_adm_user，来自 app.env Authentication__Username），
        # 不再传数据库角色名 mailarchiver（那是 "no account named 'mailarchiver'" 的根因）；
        # 数据库角色名由组件内部 DB_USER（默认 mailarchiver）负责。
        runtime_settings_apply "${_dbpw}" "${_admpw}" \
            "${APP_NAME}-db" "${_adm_user}" "mailarchiver" \
            "${_rs_files}" "${CFG_DIR}" || true
    else
        fail "缺少 cmd/lib/runtime-settings.sh（fpk 打包不完整）"
    fi
fi

# 3) 改时区
tz="${wizard_timezone:-}"
if [ -n "${tz}" ]; then
    sed -i "s#^TimeZone__DisplayTimeZoneId=.*#TimeZone__DisplayTimeZoneId=${tz}#; s#^TZ=.*#TZ=${tz}#" "${APP_ENV}" 2>/dev/null \
        || fail "写入时区失败：${APP_ENV}"
    say "时区已更新为 ${tz}"
fi

# ---------------------------------------------------------------- 运行期目录（权威：cmd/lib_runtime_dirs.sh）
LIB_DIRS="$(dirname "$0")/lib_runtime_dirs.sh"
if [ -r "${LIB_DIRS}" ]; then
    . "${LIB_DIRS}"
else
    fail "缺少 ${LIB_DIRS}（fpk 打包不完整）"
fi


# 0.1.22：不再需要后台化 fast-path —— 方案 B 下运行期不切目录，保存本身<10s。

ensure_payload_docker_dir   # 0.1.22：修——必须在本行之前 source 过 lib_runtime_dirs，否则 command not found
ensure_runtime_dirs
verify_runtime_dirs || fail "运行目录属主/权限校验失败"

# 4) 把 admin_password 同步进 app.env（唯一真源是 admin_password 文件）
if [ -s "${CFG_DIR}/admin_password" ]; then
    cur="$(head -n1 "${CFG_DIR}/admin_password")"
    sed -i "s#^Authentication__Password=.*#Authentication__Password=${cur}#" "${APP_ENV}" 2>/dev/null || true
fi

# 5) settings.env 同步（脚本自用）
(umask 077; cat >"${SETTINGS}" <<EOF
DATA_MODE=${data_mode}
DATA_ROOT=${DATA_ROOT}
DATA_TARGET=$(readlink "${DATA_ROOT}" 2>/dev/null || echo "${DATA_ROOT}")
TZ_ID=$(grep -m1 '^TZ=' "${APP_ENV}" 2>/dev/null | cut -d= -f2)
ADMIN_USER=$(grep -m1 '^Authentication__Username=' "${APP_ENV}" 2>/dev/null | cut -d= -f2)
INSTALLED_VERSION=${TRIM_APPVER:-0.1.0}
EOF
) 2>/dev/null || true

# 5b) 渲染到载荷（compose 读的是 ${TRIM_APPDEST}/docker/app.env）
mkdir -p "${APPDEST}/docker" 2>/dev/null || true
install -m 600 "${APP_ENV}" "${APPDEST}/docker/app.env" 2>/dev/null \
    || warn "渲染 ${APPDEST}/docker/app.env 失败，容器可能仍用旧配置。"
# 平台按 ${TRIM_APPDEST}/docker/ 起栈：该目录必须同时有 compose 文件（缺了会 "service postgres has no container to start"）
_src_compose="${APPCENTER:-/vol1/@appcenter/${APP_NAME}}/docker/docker-compose.yaml"
if [ -f "${_src_compose}" ]; then
    install -m 644 "${_src_compose}" "${APPDEST}/docker/docker-compose.yaml" 2>/dev/null || true
fi
# ★ 必须**始终**把口令写进载荷：空文件会让 PostgreSQL 在初始化新 pgdata 时把角色口令设成空值，
#   而应用用真口令连接 ⇒ `28P01 password authentication failed` ⇒ 每个请求都报错 ⇒ 打开应用**空白页**
#   （实测：/ 会 302 到 /Auth/Login?returnUrl=/Home/Error 并循环，最终浏览器给出空白）
# 0.1.31：写入口令走 guard
for _l in pg-password-guard.sh; do [ -r "$(dirname "$0")/lib/${_l}" ] && . "$(dirname "$0")/lib/${_l}" 2>/dev/null || true; done
# 0.1.32：判据改为「缺失或不合规才生成」（不再只看非空）
if ! pg_password_is_valid "$(head -n1 "${CFG_DIR}/pg_password" 2>/dev/null | tr -d '\r\n')" 2>/dev/null; then
    _np="$(command -v generate_pg_password >/dev/null 2>&1 && generate_pg_password || (LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32))"
    write_pg_password_guarded "${CFG_DIR}/pg_password" "${_np}" || warn "口令写入被 guard 拒绝（继续，稍后重试）"
    say "检测到 PostgreSQL 口令缺失，已重新生成（600）。"
fi
backfill_pg_password "${APPDEST}/docker/pg_password" "${CFG_DIR}/pg_password" >/dev/null 2>&1 \
    || warn "载荷口令回填失败（权威口令不合规）；新库初始化可能使用空口令。"
# P0：容器以 ${TRIM_UID}:${TRIM_GID} 运行，读 secret/env_file —— 载荷里这些文件必须是**该用户**可读，
#      否则 DB 起不来（/run/secrets/pg_password: Permission denied）。
for _f in app.env pg_password docker-compose.yaml; do
    [ -f "${APPDEST}/docker/${_f}" ] || continue
    chown "${TRIM_UID}:${TRIM_GID}" "${APPDEST}/docker/${_f}" 2>/dev/null || true
    case "${_f}" in docker-compose.yaml) chmod 644 "${APPDEST}/docker/${_f}" 2>/dev/null || true ;; *) chmod 600 "${APPDEST}/docker/${_f}" 2>/dev/null || true ;; esac
done

# 6) 配置已落盘，但【不自动重建容器】
#    原因（P0，已实测）：`compose up -d --force-recreate` 会把正在使用的容器当场杀掉，
#    用户看到的就是"进入界面后立即闪退"。改为把重启交给用户/平台状态机：
#      · 配置已经写进 ${CFG_DIR}/app.env 与载荷 docker/app.env，重启后即生效；
#      · 用户点一下应用中心「停止 → 启动」即可，无需重装。
say "配置已保存：**需要重启应用后才生效**（应用中心 → 停止 → 启动）。当前页面不会被打断（这是为了避免打断正在使用的人）。"
if docker compose version >/dev/null 2>&1; then
    say "若要立即生效，请到应用中心点一次「重启」；本脚本不会自动重启，以免打断正在使用的人。"
else
    warn "docker compose 不可用；配置已保存，请在应用中心手动停止/启动。"
fi

trace "config_callback ok"
exit 0
