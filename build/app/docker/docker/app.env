# 冷启动占位值：install_callback 会用真实值覆盖本文件（权威副本在 @appconf）。
# 为什么载荷里必须有一份：平台在 install_callback 之前就会校验 compose，
# 引用不存在的 env_file 会让安装直接失败（已实测：code 10266）。
LISTEN_UNIX_SOCKET=/tmp/app-coldstart.sock
PATH_BASE=/app/mail-archiver-fnos
Gateway__Enabled=true
Gateway__UserIdHeader=X-Trim-Userid
Gateway__UsernameHeader=X-Trim-Username
Gateway__LogoutRedirectUrl=
Localization__DefaultCulture=zh-CN
Authentication__CookieSameSite=Strict
Authentication__Username=admin
Authentication__Password=PH_47dlh7oYyso2ZmBsIxTWidZG
TimeZone__DisplayTimeZoneId=Asia/Shanghai
TZ=Asia/Shanghai
DataProtection__KeyPath=/data/DataProtection-Keys
Security__EncryptAccountCredentials=true
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=mailarchiver;Username=mailarchiver;Password=PH_47dlh7oYyso2ZmBsIxTWidZG;Pooling=true
ReleaseNotes__Enabled=false
